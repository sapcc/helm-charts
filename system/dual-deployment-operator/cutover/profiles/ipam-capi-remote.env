RELEASE=ipam-capi-remote
DDO_CR=ipam-capi-remote
LEGACY_CHART_DIR=system/ipam-capi-remote
ROLLOUT_ORDER=40

# ============================================================================
# Cutover engine fields (Layer 2)
# ============================================================================

# Controller Deployment name on the seed cluster
DEPLOY=ipam-capi-controller-manager

# Pod selector for the controller (used in teardown barrier)
CONTROLLER_POD_SELECTOR="control-plane=controller-manager,app.kubernetes.io/name=ipam-capi-remote"

# CRD API groups — checked for keepObjects:true and UID preservation
CRD_GROUPS="ipam.cluster.x-k8s.io"

# ipam owns no namespace via ManagedResource, so namespace cascade protection
# is disabled.
NAMESPACE_CASCADE_GATE="off"

# ipam-capi-remote has NO out-of-band pool ManagedResources to protect.
# The 2 live GlobalInClusterIPPools on m-qa-de-200 (globalinclusterippool-mgmt-qa-de-200
# UID 83614ed7-f367-4bd0-acdd-4fbd4de76eec, and test UID d7d99994-c27d-4116-835b-4d858069b7ea)
# are NOT chart-delivered and have no owning ManagedResource. The cutover BASELINE-snapshots
# them and the verify phase asserts both UIDs SURVIVE unchanged.
PROTECT_MRS=""

# Freeze kinds — resources checked for deletionTimestamp before uninstall
FREEZE_KINDS_CLUSTER=""
FREEZE_KINDS_NS="globalinclusterippools.ipam.cluster.x-k8s.io"

# Server state machine checks — NOT applicable to ipam
FREEZE_SERVER_STATES=0

# Operand chart directory — OMITTED for ipam-capi-remote.
# ipam-capi-remote is delivered via DDO source.kustomize (layered overlay), NOT a Helm
# chart. The P5 preflight gate runs `helm template` only when OPERAND_CHART_DIR is set;
# omitting it skips the Helm-only render check (which would fail on a kustomize tree).
# OPERAND_CHART_DIR is intentionally unset.

# Baseline snapshot kinds — dumped pre-uninstall for diffing.
# These capture the 2 live out-of-band GlobalInClusterIPPools (mgmt-qa-de-200 and test)
# to verify their UIDs survive the cutover.
BASELINE_SNAPSHOT_KINDS_CLUSTER=""
BASELINE_SNAPSHOT_KINDS_NS="globalinclusterippools.ipam.cluster.x-k8s.io"

# Verify sample — ipam CR preservation is checked via the baseline snapshot.
VERIFY_SAMPLE=""

# The owned-by label stamped by DDO on managed resources
OWNED_BY_LABEL="dual-deployment-operator.cc.sap/owned-by"
