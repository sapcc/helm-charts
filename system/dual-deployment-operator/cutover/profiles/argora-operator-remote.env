RELEASE=argora-operator-remote
DDO_CR=argora-operator-remote
LEGACY_CHART_DIR=system/argora-operator-remote
ROLLOUT_ORDER=30

# ============================================================================
# Cutover engine fields (Layer 2)
# ============================================================================

# Controller Deployment name on the seed cluster
DEPLOY=argora-operator-controller-manager

# Pod selector for the controller (used in teardown barrier)
CONTROLLER_POD_SELECTOR="app.kubernetes.io/name=argora-operator-core"

# CRD API groups — checked for keepObjects:true and UID preservation
CRD_GROUPS="argora.cloud.sap"

# argora owns no namespace via ManagedResource, so namespace cascade protection
# is disabled. The three data-CR MRs below lack keepObjects (unlike the CRD
# MRs, which have keepObjects:true) and must be protected before uninstall so
# DDO can adopt the live CRs with the same UID.
NAMESPACE_CASCADE_GATE="off"
PROTECT_MRS="mr-ci-mgmt-qa-de-200 mr-ippi-sci-k8s-management mr-u-mgmt-qa-de-200"

# Freeze kinds — resources checked for deletionTimestamp before uninstall
FREEZE_KINDS_CLUSTER=""
FREEZE_KINDS_NS="clusterimports.argora.cloud.sap ippoolimports.argora.cloud.sap updates.argora.cloud.sap"

# Server state machine checks — NOT applicable to argora
FREEZE_SERVER_STATES=0

# Operand chart directory (for helm template validation in preflight)
OPERAND_CHART_DIR=system/argora-operator-remote-ddo

# Baseline snapshot kinds — dumped pre-uninstall for diffing
BASELINE_SNAPSHOT_KINDS_CLUSTER=""
BASELINE_SNAPSHOT_KINDS_NS="clusterimports.argora.cloud.sap ippoolimports.argora.cloud.sap updates.argora.cloud.sap"

# Verify sample — argora CR preservation is checked via the baseline snapshot.
VERIFY_SAMPLE=""

# The owned-by label stamped by DDO on managed resources
OWNED_BY_LABEL="dual-deployment-operator.cc.sap/owned-by"
