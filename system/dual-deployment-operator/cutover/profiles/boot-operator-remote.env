RELEASE=boot-operator-remote
DDO_CR=boot-operator-remote
LEGACY_CHART_DIR=system/boot-operator-remote
ROLLOUT_ORDER=20

# ============================================================================
# Cutover engine fields (Layer 2)
# ============================================================================

# Controller Deployment name on the seed cluster
DEPLOY=boot-operator-controller-manager

# Pod selector for the controller (used in teardown barrier)
CONTROLLER_POD_SELECTOR="app.kubernetes.io/name=boot-operator-core"

# CRD API groups — checked for keepObjects:true and UID preservation
CRD_GROUPS="boot.ironcore.dev"

# Namespace cascade gate: "on <mr-name> <namespace>" or "off"
# boot-operator does NOT own a namespace via ManagedResource, so this is OFF.
# The teardown barrier's namespace survival check is SKIPPED entirely.
NAMESPACE_CASCADE_GATE="off"

# Freeze kinds — resources checked for deletionTimestamp before uninstall
# boot-operator has NO cluster-scoped CRs
FREEZE_KINDS_CLUSTER=""
# Namespaced kinds (checked with -A)
FREEZE_KINDS_NS="httpbootconfigs.boot.ironcore.dev ipxebootconfigs.boot.ironcore.dev"

# Server state machine checks — NOT applicable to boot-operator
# boot has no hardware state machine, only CR deletionTimestamp checks.
FREEZE_SERVER_STATES=0

# Operand chart directory (for helm template validation in preflight)
OPERAND_CHART_DIR=system/boot-operator-remote-ddo

# Baseline snapshot kinds — dumped pre-uninstall for diffing
BASELINE_SNAPSHOT_KINDS_CLUSTER=""
BASELINE_SNAPSHOT_KINDS_NS="httpbootconfigs.boot.ironcore.dev ipxebootconfigs.boot.ironcore.dev"

# Verify sample — foreign-shoot object(s) to assert do-no-harm
# An IPXEBootConfig in the shared metal-servers namespace belonging to another shoot
VERIFY_SAMPLE="ipxebootconfig -n metal-servers shoot--cp--mig-test-metal-metal-ipxe-sample"

# The owned-by label stamped by DDO on managed resources
OWNED_BY_LABEL="dual-deployment-operator.cc.sap/owned-by"
