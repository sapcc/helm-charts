RELEASE=metal-operator-remote
DDO_CR=metal-operator-remote
LEGACY_CHART_DIR=system/metal-operator-remote
ROLLOUT_ORDER=10

# ============================================================================
# Cutover engine fields (Layer 2)
# ============================================================================

# Controller Deployment name on the seed cluster
DEPLOY=metal-operator-controller-manager

# Pod selector for the controller (used in teardown barrier)
CONTROLLER_POD_SELECTOR="app.kubernetes.io/name=metal-operator-core"

# CRD API groups — checked for keepObjects:true and UID preservation
CRD_GROUPS="metal.ironcore.dev"

# Namespace cascade gate: "on <mr-name> <namespace>" or "off"
# When "on", protect_namespace_mr() patches the MR to keepObjects:true
# and the teardown barrier verifies the namespace survives.
NAMESPACE_CASCADE_GATE="on mr-n-metal-servers metal-servers"

# Freeze kinds — resources checked for deletionTimestamp before uninstall
# Cluster-scoped kinds (checked without -n)
FREEZE_KINDS_CLUSTER="servers.metal.ironcore.dev bmcs.metal.ironcore.dev biossettings.metal.ironcore.dev biosversions.metal.ironcore.dev"
# Namespaced kinds (checked with -A)
FREEZE_KINDS_NS="serverclaims.metal.ironcore.dev serverbootconfigurations.metal.ironcore.dev servermaintenances.metal.ironcore.dev"

# Server state machine checks (metal-specific)
# When set to 1, the freeze gate also checks Server.status.state is stable
# and BIOSSettings/BIOSVersion are not mid-operation.
FREEZE_SERVER_STATES=1
SERVER_STABLE_STATES_REGEX='^(Available|Reserved|Error|Maintenance|Tainted)$'

# Operand chart directory (for helm template validation in preflight)
OPERAND_CHART_DIR=system/metal-operator-remote-ddo

# Baseline snapshot kinds — dumped pre-uninstall for diffing
BASELINE_SNAPSHOT_KINDS_CLUSTER="servers.metal.ironcore.dev bmcs.metal.ironcore.dev"
BASELINE_SNAPSHOT_KINDS_NS="serverclaims.metal.ironcore.dev serverbootconfigurations.metal.ironcore.dev"

# Verify sample — OPTIONAL foreign-shoot object(s) to assert do-no-harm.
# Landscape-specific: name a real object owned by ANOTHER shoot to prove the
# cutover did not disturb anything outside its scope. Leave EMPTY to skip the
# do-no-harm sample check (the verify phase skips it when unset/empty).
# Format when set: "<kind> <name>" or "<kind> -n <namespace> <name>"
VERIFY_SAMPLE=""

# The owned-by label stamped by DDO on managed resources
OWNED_BY_LABEL="dual-deployment-operator.cc.sap/owned-by"
