RELEASE=disco-remote
DDO_CR=disco-remote
LEGACY_CHART_DIR=system/disco
ROLLOUT_ORDER=50

# ============================================================================
# Cutover engine fields (Layer 2)
# ============================================================================

# Controller Deployment name on the seed cluster
DEPLOY=disco-controller-manager

# Pod selector for the controller (used in teardown barrier).
# The disco chart Deployment uses matchLabels {app: disco} (NOT the
# app.kubernetes.io/name convention the other operands use), so the engine's
# default selector (app.kubernetes.io/name=$DEPLOY) would match ZERO pods and
# falsely report the controller gone. Pin the real selector here.
CONTROLLER_POD_SELECTOR="app=disco"

# CRD API groups — checked for keepObjects:true and UID preservation
CRD_GROUPS="disco.stable.sap.cc"

# CRD-protecting ManagedResource inventory (authoritative when set).
# The four other legacy remote charts render per-object MRs via an mrname
# helper (CustomResourceDefinition -> mr-crd-<name>), so the engine derives the
# CRD-MR set from the mr-crd-* prefix when CRD_MRS is empty. disco's legacy
# chart (system/disco) is the lone exception: it hand-writes a single MR named
# "<release>-crd" = disco-remote-crd (keepObjects:true, wrapping
# crds/records.disco.stable.sap.cc.yaml). Name it explicitly so every CRD-MR
# check (evidence capture, Gate 3 keepObjects, coverage, teardown barrier)
# resolves it instead of the prefix.
CRD_MRS="disco-remote-crd"

# Namespace cascade gate: "on <mr-name> <namespace>" or "off".
# disco owns no namespace via ManagedResource (it delivers into kube-system,
# which it does not own), so this is OFF.
NAMESPACE_CASCADE_GATE="off"

# disco has no out-of-band data-CR MRs lacking keepObjects (unlike argora):
# the only non-CRD MR, disco-remote-rbac, is intentionally GC'd on uninstall so
# the new DDO render can re-own the shoot RBAC. Nothing to protect from cascade.
PROTECT_MRS=""

# Freeze kinds — resources checked for deletionTimestamp before uninstall.
# disco has NO cluster-scoped CRs; Records are Namespaced
# (records.disco.stable.sap.cc, kind Record, scope Namespaced).
FREEZE_KINDS_CLUSTER=""
FREEZE_KINDS_NS="records.disco.stable.sap.cc"

# Server state machine checks — NOT applicable to disco (no hardware FSM).
FREEZE_SERVER_STATES=0

# Operand chart directory (for helm template validation in preflight).
# disco-ddo is Helm-sourced (unlike kustomize-sourced ipam), so set it.
OPERAND_CHART_DIR=system/disco-ddo

# Baseline snapshot kinds — dumped pre-uninstall for diffing
BASELINE_SNAPSHOT_KINDS_CLUSTER=""
BASELINE_SNAPSHOT_KINDS_NS="records.disco.stable.sap.cc"

# Verify sample — disco Record preservation is checked via the baseline snapshot.
VERIFY_SAMPLE=""

# The owned-by label stamped by DDO on managed resources
OWNED_BY_LABEL="dual-deployment-operator.cc.sap/owned-by"
