RELEASE=kube-state-metrics-remote
DDO_CR=kube-state-metrics-remote
LEGACY_CHART_DIR=system/kube-state-metrics-remote
ROLLOUT_ORDER=60

# ============================================================================
# Cutover engine fields (Layer 2)
# ============================================================================

# Controller Deployment name on the seed cluster
DEPLOY=kube-state-metrics-remote

# Pod selector for the controller (used in teardown barrier)
CONTROLLER_POD_SELECTOR="app.kubernetes.io/name=kube-state-metrics-remote"

# kube-state-metrics-remote owns NO CRDs: it is a read-only scraper that
# watches existing CRs but does not define any API group itself.
# NO_CRDS=1 disables all CRD-related gates (preflight_crds_on_target,
# preflight_mr_keepobjects, CRD baselines, CRD coverage) that would otherwise
# die on empty CRD_GROUPS / crd-mrs.txt. Every other gate (DDO health,
# readiness/freeze evidence, release ownership, uninstall barriers, resume)
# still applies.
NO_CRDS=1
CRD_GROUPS=""
CRD_MRS=""

# Namespace cascade gate: "on <mr-name> <namespace>" or "off".
# kube-state-metrics-remote owns no namespace via ManagedResource.
NAMESPACE_CASCADE_GATE="off"

# The three shoot-RBAC ManagedResources (mr-sa-kube-state-metrics-remote,
# mr-cr-kube-state-metrics-remote, mr-crb-kube-state-metrics-remote) all lack
# keepObjects and are intentionally GC'd on uninstall so DDO can re-own shoot
# RBAC. No data-CR MRs to protect.
PROTECT_MRS=""

# Freeze kinds — no cluster-scoped or namespaced CRs owned by this operator.
FREEZE_KINDS_CLUSTER=""
FREEZE_KINDS_NS=""

# Server state machine checks — NOT applicable
FREEZE_SERVER_STATES=0

# Operand chart directory (for helm template validation in preflight).
OPERAND_CHART_DIR=system/kube-state-metrics-remote-ddo

# Baseline snapshot kinds — kube-state-metrics-remote owns no data CRs and no
# namespaced CRs, so no baseline snapshot is needed.
BASELINE_SNAPSHOT_KINDS_CLUSTER=""
BASELINE_SNAPSHOT_KINDS_NS=""

# Verify sample — no out-of-band sample needed (no data CRs to assert).
VERIFY_SAMPLE=""

# The owned-by label stamped by DDO on managed resources
OWNED_BY_LABEL="dual-deployment-operator.cc.sap/owned-by"
