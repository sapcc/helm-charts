groups:
- name: thanos-global-target-health.alerts
  rules:

  # Fires once per (support_group, ccloud_service, cluster) when one or more
  # scrape targets are down. label_replace handles targets missing ccloud_service.
  - alert: ScrapeTargetDown
    expr: |
      count by (ccloud_support_group, ccloud_service, cluster) (
        label_replace(
          min by (job, instance, cluster, region, namespace, service, ccloud_service, ccloud_support_group) (
            up{ccloud_support_group!=""} == 0
          ),
          "ccloud_service", "(unknown)", "ccloud_service", "^$"
        )
      ) > 0
    for: 10m
    labels:
      severity: warning
      service: metrics
      support_group: {{ $labels.ccloud_support_group }}
      meta: {{ $value }} target(s) down — service: {{ $labels.ccloud_service }} cluster: {{ $labels.cluster }} ({{ $labels.ccloud_support_group }})
      playbook: docs/support/playbook/prometheus/failed_scrapes
      persesDashboard: "https://perses.global.cloud.sap/projects/observability/dashboards/thanos-target-health?var-support_group={{ $labels.ccloud_support_group }}"
    annotations:
      summary: Scrape targets down for support group {{ $labels.ccloud_support_group }}
      description: {{ $value }} target(s) for service {{ $labels.ccloud_service }} in cluster {{ $labels.cluster }} owned by {{ $labels.ccloud_support_group }} have been down for more than 10 minutes. For more details see the Perses dashboard.
