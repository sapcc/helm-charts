# vim: set ft=yaml:

groups:
- name: openstack-content-repo.alerts
  rules:
  - alert: OpenstackContentRepoMetricsMissing
    expr: absent(repo_sync_last_run) or absent(repo_sync_check_success) or absent(repo_sync_check_httpcode)
    for: 24h
    labels:
      support_group: containers
      tier: os
      service: repo
      severity: info
      context: repo
    annotations:
      description: Some content repo metrics have been missing for 24h. Check the logs of the corresponding statsd pod.
      summary: Some content repo metrics are missing

  - alert: OpenstackRepo
    expr: floor((time()-repo_sync_last_run{kind="success_timestamp"})/60/60) > 48
    for: 10m
    labels:
      no_alert_on_absence: "true" # See OpenstackContentRepoMetricsMissing alert.
      support_group: containers
      tier: os
      service: repo
      severity: info
      context: repo
      meta: "repo {{ $labels.repo }} is outdated"
    annotations:
      description: Content repo {{ $labels.repo }} was not successfully updated for at least 48h. Check the logs. When running multiple backends the repo label is <name>-<target> (e.g. ubuntu-ceph).
      summary: Content repo {{ $labels.repo }} outdated

  - alert: OpenstackRepoSkippedJobs
    expr: repo_sync_last_run{kind="jobs_skipped"} > 0
    for: 10m
    labels:
      no_alert_on_absence: "true" # See OpenstackContentRepoMetricsMissing alert.
      support_group: containers
      tier: os
      service: repo
      severity: info
      context: repo
      meta: "repo {{ $labels.repo }} has skipped some sync jobs"
    annotations:
      description: Content repo {{ $labels.repo }} has skipped some sync jobs. Check the logs. When running multiple backends the repo label is <name>-<target> (e.g. ubuntu-ceph).
      summary: Content repo {{ $labels.repo }} outdated

  - alert: OpenstackRepoEntitlementForbidden
    expr: repo_sync_check_success != 1 and repo_sync_check_httpcode == 403
    for: 1h
    labels:
      no_alert_on_absence: "true" # See OpenstackContentRepoMetricsMissing alert.
      support_group: containers
      tier: os
      service: repo
      severity: info
      context: repo-{{ $labels.repo }}-entitlement
      meta: "invalid entitlement for {{ $labels.repo }}"
      playbook: 'https://operations.global.cloud.sap/docs/support/playbook/repo_rhel_entitlement'
    annotations:
      description: Repo {{ $labels.repo }} the entitlement became invalid
      summary: Repo {{ $labels.repo }} entitlement lost

  - alert: OpenstackRepoEntitlement
    expr: repo_sync_check_success != 1 and repo_sync_check_httpcode != 403
    for: 1h
    labels:
      no_alert_on_absence: "true" # See OpenstackContentRepoMetricsMissing alert.
      support_group: containers
      tier: os
      service: repo
      severity: info
      context: repo-{{ $labels.repo }}-entitlement
      meta: "entitlement check failed for {{ $labels.repo }}"
    annotations:
      description: Repo {{ $labels.repo }} entitlement check failed. Check the logs
      summary: Repo {{ $labels.repo }} entitlement check failed

  - alert: OpenstackContentRepoPayloadsCephQuotaAlmostExhausted
    expr: limitas_project_resource_usage{project="content-repo-payloads",service="ceph",resource="region-premium"} / limitas_project_resource_quota{project="content-repo-payloads",service="ceph",resource="region-premium"} > 0.95
    for: 10m
    labels:
      support_group: containers
      tier: os
      service: repo
      severity: warning
      context: repo
      meta: content-repo-payloads project is almost out of Ceph quota
    annotations:
      summary: content-repo-payloads project is almost out of Ceph quota
      description: |
        The content-repo-payloads project has used more than 95% of its Ceph region-premium quota.
        Add a commitment in the <https://dashboard.{{ $labels.region }}.cloud.sap/ccadmin/cloud_admin/resources/v2/cluster?cluster_id=current#/storage/edit/ceph/region-premium?resource=region-premium|Cloud Resource Admin view in Elektra> to increase the quota.
